{
  "name": "qrcode",
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "node .dev/dev.mjs",
    "dev:chrome": "node .dev/dev.mjs -b chrome",
    "dev:edge": "node .dev/dev.mjs -b edge",
    "dev:firefox": "node .dev/dev.mjs -b firefox --mv3",
    "build": "wxt zip",
    "build:firefox": "wxt zip -b firefox --mv3",
    "submit:firefox": "node .dev/submit.mjs firefox",
    "submit:edge": "node .dev/submit.mjs edge",
    "submit:chrome": "node .dev/submit.mjs chrome",
    "submit": "node .dev/submit.mjs all",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@zxing/library": "^0.23.0",
    "qrcode-generator": "^2.0.4",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@wxt-dev/module-vue": "^1.0.3",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.4",
    "web-ext": "^10.8.0",
    "wxt": "0.21.4"
  }
}